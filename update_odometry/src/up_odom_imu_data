#!/usr/bin/env python

import rospy
from std_msgs.msg import Float32MultiArray
from sensor_msgs.msg import Imu
from nav_msgs.msg import Odometry
import tf2_ros
import tf
import math
from tf.transformations import quaternion_from_euler

class OdomNode:
    def __init__(self):
        rospy.init_node('odom_node', anonymous=True)

        # Robot parameters
        self.wheel_radius = 0.0485  # meters
        self.lx = 0.259  # distance from center to wheel along x (meters)
        self.ly = 0.210  # distance from center to wheel along y (meters)

        # State variables
        self.distances = [0.0, 0.0, 0.0, 0.0]  # Wheel displacements
        self.vx = 0.0  # Robot linear velocity (x)
        self.vy = 0.0  # Robot linear velocity (y)
        self.omega = 0.0  # Robot angular velocity
        self.x = 0.0  # Robot position (x)
        self.y = 0.0  # Robot position (y)
        self.theta = 0.0  # Robot orientation (yaw)
        self.last_time = rospy.Time.now()
        self.last_theta = 0.0  # Previous IMU yaw

        # Initialize quaternion (identity)
        self.orientation_q = [0.0, 0.0, 0.0, 1.0]  # [x, y, z, w]

        # ROS subscribers and publishers
        rospy.Subscriber('DisWheel', Float32MultiArray, self.distance_callback)
        rospy.Subscriber('imu/data', Imu, self.imu_callback)
        self.odom_pub = rospy.Publisher('odom', Odometry, queue_size=10)
        self.odom_broadcaster = tf2_ros.TransformBroadcaster()

        self.rate = rospy.Rate(10)  # 10 Hz

    def distance_callback(self, msg):
        if len(msg.data) >= 4:
            self.distances = list(msg.data[:4])  # [FL, FR, BR, BL]

    def imu_callback(self, msg):
        # Store IMU quaternion
        self.orientation_q = [
            msg.orientation.x,
            msg.orientation.y,
            msg.orientation.z,
            msg.orientation.w
        ]

    def calculate_mecanum_kinematics(self, dt):
        # Calculate wheel velocities (displacement / time)
        v_fl = self.distances[0]   # Front Left
        v_fr = self.distances[1]  # Front Right
        
        v_bl = self.distances[2]  # Back Left
        v_br = self.distances[3]   # Back Right

        # Mecanum kinematics
        self.vx = (v_fl + v_fr + v_bl+ v_br ) / 4.0
        self.vy = (-v_fl + v_fr + v_bl - v_br ) / 4.0
        self.omega = (-v_fl + v_fr - v_bl + v_br ) / (4.0 * (self.lx + self.ly))

        # Get yaw from IMU quaternion
        _, _, yaw = tf.transformations.euler_from_quaternion(self.orientation_q)
        delta_theta = yaw - self.last_theta
        if delta_theta > math.pi:
            delta_theta -= 2 * math.pi
        elif delta_theta < -math.pi:
            delta_theta += 2 * math.pi

        # Detect IMU drift by comparing with wheel odometry
        omega_imu = delta_theta / dt
        if abs(self.omega - omega_imu) > 0.5:  # Threshold may need tuning
            
            delta_theta = self.omega * dt

        self.theta += delta_theta
        self.last_theta = yaw

        # Update position using robot frame velocities
        delta_x = (self.vx * math.cos(self.theta) - self.vy * math.sin(self.theta))
        delta_y = (self.vx * math.sin(self.theta) + self.vy * math.cos(self.theta)) 
        self.y += delta_y
        

    def publish_odom(self):
        while not rospy.is_shutdown():
            current_time = rospy.Time.now()
            dt = (current_time - self.last_time).to_sec()

            if dt > 0.001:  # Avoid division by small dt
                self.calculate_mecanum_kinematics(dt)
                x_gain =  42.14
                y_gain = 39.3158
                q = quaternion_from_euler(0, 0, self.orientation_q[2])
                # Create TF transform
                t = tf2_ros.TransformStamped()
                t.header.stamp = current_time
                t.header.frame_id = "odom"
                t.child_frame_id = "base_footprint"
                t.transform.translation.x = self.x*x_gain
                t.transform.translation.y = self.y*y_gain
                t.transform.translation.z = 0.0
                t.transform.rotation.x = self.orientation_q[0]
                t.transform.rotation.y = self.orientation_q[1]
                t.transform.rotation.z = self.orientation_q[2]
                t.transform.rotation.w = q[3]
                self.odom_broadcaster.sendTransform(t)

                # Publish odometry message
                odom = Odometry()
                odom.header.stamp = current_time
                odom.header.frame_id = "odom"
                odom.child_frame_id = "base_footprint"
                odom.pose.pose.position.x = self.x * x_gain # Removed scaling by 40
                odom.pose.pose.position.y = self.y  * y_gain
                odom.pose.pose.position.z = 0.0
                odom.pose.pose.orientation.x = self.orientation_q[0]
                odom.pose.pose.orientation.y = self.orientation_q[1]
                odom.pose.pose.orientation.z = self.orientation_q[2]
                odom.pose.pose.orientation.w = q[3]
                odom.twist.twist.linear.x = self.vx
                odom.twist.twist.linear.y = self.vy
                odom.twist.twist.angular.z = self.omega
                self.odom_pub.publish(odom)
                

            self.last_time = current_time
            self.rate.sleep()

if __name__ == '__main__':
    try:
        node = OdomNode()
        node.publish_odom()
    except rospy.ROSInterruptException:
        pass
